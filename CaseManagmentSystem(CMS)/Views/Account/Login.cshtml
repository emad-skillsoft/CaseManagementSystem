@model CaseManagementSystem.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Login - Case Management System</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/CaseManagementSystem.styles.css"
          asp-append-version="true" />

</head>


<body class="cms-login-body">


    <!-- =====================================================
         SECURITY CLASSIFICATION
         ===================================================== -->

    <div class="cms-classification-bar">

        <span class="cms-classification-lock">

            <svg width="12"
                 height="12"
                 viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2">

                <rect x="5"
                      y="11"
                      width="14"
                      height="10"
                      rx="2">
                </rect>

                <path d="M8 11V7a4 4 0 0 1 8 0v4">
                </path>

            </svg>

        </span>

        <span>
            RESTRICTED • INTERNAL USE ONLY
        </span>

    </div>



    <!-- =====================================================
         LOGIN PAGE
         ===================================================== -->

    <div class="cms-login-page">


        <!-- =================================================
             LEFT BRANDING PANEL
             ================================================= -->

        <section class="cms-login-brand-panel">


            <div class="cms-brand-content">


                <!-- System Logo -->
                <div class="cms-brand-logo">

                    <svg viewBox="0 0 64 64"
                         fill="none"
                         xmlns="http://www.w3.org/2000/svg">


                        <!-- Shield -->
                        <path d="
                        M32 5
                        L52 13
                        V29
                        C52 42.5 43.6 53.7 32 59
                        C20.4 53.7 12 42.5 12 29
                        V13
                        L32 5Z"
                              stroke="currentColor"
                              stroke-width="2.5"
                              stroke-linejoin="round" />


                        <!-- Case Document -->
                        <rect x="20"
                              y="19"
                              width="20"
                              height="24"
                              rx="3"
                              stroke="currentColor"
                              stroke-width="2.3" />

                        <path d="M24 25H35"
                              stroke="currentColor"
                              stroke-width="2.3"
                              stroke-linecap="round" />

                        <path d="M24 31H33"
                              stroke="currentColor"
                              stroke-width="2.3"
                              stroke-linecap="round" />


                        <!-- Magnifying Glass -->
                        <circle cx="41"
                                cy="40"
                                r="6"
                                fill="#092338"
                                stroke="currentColor"
                                stroke-width="2.3" />

                        <path d="M45.5 44.5L50 49"
                              stroke="currentColor"
                              stroke-width="2.3"
                              stroke-linecap="round" />

                    </svg>

                </div>


                <!-- System Name -->
                <h1 class="cms-brand-title">

                    CASE MANAGEMENT

                    <span>
                        SYSTEM
                    </span>

                </h1>


                <!-- Accent Line -->
                <div class="cms-brand-accent">
                </div>


                <!-- System Tagline -->
                <p class="cms-brand-tagline">
                    SECURE CASE OPERATIONS
                </p>


            </div>



            <!-- Security Notice -->
            <div class="cms-brand-security">


                <div class="cms-security-icon">

                    <svg width="18"
                         height="18"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2">

                        <rect x="5"
                              y="11"
                              width="14"
                              height="10"
                              rx="2">
                        </rect>

                        <path d="M8 11V7a4 4 0 0 1 8 0v4">
                        </path>

                    </svg>

                </div>


                <div>

                    <strong>
                        Authorized users only
                    </strong>

                    <span>
                        Access to this system is monitored.
                    </span>

                </div>


            </div>


        </section>



        <!-- =================================================
             RIGHT LOGIN PANEL
             ================================================= -->

        <main class="cms-login-form-panel">


            <div class="cms-login-card">


                <!-- Login Icon -->
                <div class="cms-login-icon">

                    <svg width="25"
                         height="25"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2">

                        <path d="
                            M12 22
                            S20 18 20 12
                            V5
                            L12 2
                            L4 5
                            V12
                            C4 18 12 22 12 22Z">
                        </path>

                        <path d="M9 12L11 14L15 10">
                        </path>

                    </svg>

                </div>



                <!-- Heading -->
                <div class="cms-login-heading">

                    <h2>
                        Welcome Back
                    </h2>

                    <p>
                        Sign in to access Case Management System
                    </p>

                </div>



                <!-- =================================================
                     LOGIN FORM
                     ================================================= -->

                <form asp-controller="Account"
                      asp-action="Login"
                      method="post"
                      class="cms-login-form">


                    @Html.AntiForgeryToken()


                    <!-- Validation Summary -->
                    <div asp-validation-summary="ModelOnly"
                         class="cms-validation-summary">
                    </div>



                    <!-- =============================================
                         USERNAME
                         ============================================= -->

                    <div class="cms-form-group">


                        <label asp-for="UserName"
                               class="cms-form-label">

                            Username

                        </label>


                        <div class="cms-input-wrapper">


                            <!-- User Icon -->
                            <span class="cms-input-icon">

                                <svg width="18"
                                     height="18"
                                     viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="2">

                                    <circle cx="12"
                                            cy="7"
                                            r="4">
                                    </circle>

                                    <path d="
                                        M20 21
                                        A8 8 0 0 0 4 21">
                                    </path>

                                </svg>

                            </span>


                            <input asp-for="UserName"
                                   class="cms-form-control"
                                   placeholder="Enter your username"
                                   autocomplete="username"
                                   autofocus />


                        </div>


                        <span asp-validation-for="UserName"
                              class="cms-field-validation">
                        </span>


                    </div>



                    <!-- =============================================
                         PASSWORD
                         ============================================= -->

                    <div class="cms-form-group">


                        <label asp-for="Password"
                               class="cms-form-label">

                            Password

                        </label>


                        <div class="cms-input-wrapper">


                            <!-- Password Icon -->
                            <span class="cms-input-icon">

                                <svg width="18"
                                     height="18"
                                     viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="2">

                                    <rect x="5"
                                          y="11"
                                          width="14"
                                          height="10"
                                          rx="2">
                                    </rect>

                                    <path d="
                                        M8 11
                                        V7
                                        A4 4 0 0 1 16 7
                                        V11">
                                    </path>

                                </svg>

                            </span>


                            <input asp-for="Password"
                                   id="cmsPassword"
                                   type="password"
                                   class="cms-form-control cms-password-input"
                                   placeholder="Enter your password"
                                   autocomplete="current-password" />



                            <!-- Show / Hide Password -->
                            <button type="button"
                                    id="cmsPasswordToggle"
                                    class="cms-password-toggle"
                                    aria-label="Show password">


                                <svg width="18"
                                     height="18"
                                     viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="2">

                                    <path d="
                                        M2 12
                                        S5.5 5 12 5
                                        S22 12 22 12
                                        S18.5 19 12 19
                                        S2 12 2 12Z">
                                    </path>

                                    <circle cx="12"
                                            cy="12"
                                            r="3">
                                    </circle>

                                </svg>


                            </button>


                        </div>


                        <span asp-validation-for="Password"
                              class="cms-field-validation">
                        </span>


                    </div>



                    <!-- =============================================
                         REMEMBER ME
                         ============================================= -->

                    <div class="cms-remember-row">


                        <label class="cms-checkbox">


                            <input asp-for="RememberMe" />


                            <span class="cms-checkbox-box">
                            </span>


                            <span class="cms-checkbox-label">
                                Remember me
                            </span>


                        </label>


                    </div>



                    <!-- =============================================
                         SIGN IN
                         ============================================= -->

                    <button type="submit"
                            class="cms-signin-button">


                        <svg width="17"
                             height="17"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2">

                            <rect x="5"
                                  y="11"
                                  width="14"
                                  height="10"
                                  rx="2">
                            </rect>

                            <path d="
                                M8 11
                                V7
                                A4 4 0 0 1 16 7
                                V11">
                            </path>

                        </svg>


                        <span>
                            Sign In
                        </span>


                    </button>


                </form>



                <!-- Security Footer -->
                <div class="cms-login-security-note">


                    <svg width="14"
                         height="14"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2">

                        <path d="
                            M12 22
                            S20 18 20 12
                            V5
                            L12 2
                            L4 5
                            V12
                            C4 18 12 22 12 22Z">
                        </path>

                    </svg>


                    <span>
                        Secure authenticated access
                    </span>


                </div>


            </div>


        </main>


    </div>



    <!-- =====================================================
         SCRIPTS
         ===================================================== -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>


    <!-- ASP.NET Validation -->
    <partial name="_ValidationScriptsPartial" />



    <!-- Show / Hide Password -->
    <script>

        document.addEventListener("DOMContentLoaded", function () {

        const passwordInput =
        document.getElementById("cmsPassword");

        const passwordToggle =
        document.getElementById("cmsPasswordToggle");


        if (!passwordInput || !passwordToggle) {
        return;
        }


        passwordToggle.addEventListener("click", function () {

        const passwordIsHidden =
        passwordInput.type === "password";


        if (passwordIsHidden) {

        passwordInput.type = "text";

        passwordToggle.setAttribute(
        "aria-label",
        "Hide password"
        );

        }
        else {

        passwordInput.type = "password";

        passwordToggle.setAttribute(
        "aria-label",
        "Show password"
        );

        }

        });

        });

    </script>


</body>

</html>