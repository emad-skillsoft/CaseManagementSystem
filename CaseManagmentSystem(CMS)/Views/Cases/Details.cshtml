@using CaseManagementSystem.Constants
@model CaseManagementSystem.ViewModels.CaseDetailsViewModel

<h2>Case Details</h2>

@if (TempData["CaseSuccess"] != null)
{
    <div class="alert alert-success">
        @TempData["CaseSuccess"]
    </div>
}

@if (TempData["CaseError"] != null)
{
    <div class="alert alert-danger">
        @TempData["CaseError"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<dl class="row">
    <dt class="col-sm-3">External ID</dt>
    <dd class="col-sm-9">@Model.ExternalCaseId</dd>

    <dt class="col-sm-3">Title</dt>
    <dd class="col-sm-9">@Model.Title</dd>

    <dt class="col-sm-3">Description</dt>
    <dd class="col-sm-9">@Model.Description</dd>

    <dt class="col-sm-3">Priority</dt>
    <dd class="col-sm-9">@Model.Priority</dd>

    <dt class="col-sm-3">Stage</dt>
    <dd class="col-sm-9">@Model.CurrentStage</dd>

    <dt class="col-sm-3">Assigned Expert</dt>
    <dd class="col-sm-9">@Model.AssignedExpertName</dd>

    <dt class="col-sm-3">SLA Start</dt>
    <dd class="col-sm-9">@Model.SLAStartDate</dd>
</dl>

<hr />

<h4>History</h4>

<table class="table table-sm">
    <thead>
        <tr>
            <th>Time</th>
            <th>Action</th>
            <th>From</th>
            <th>To</th>
            <th>Comment</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var h in Model.History)
        {
            <tr>
                <td>@h.CreatedAt</td>
                <td>@h.Action</td>
                <td>@h.PreviousStage</td>
                <td>@h.NewStage</td>
                <td>@h.Comment</td>
            </tr>
        }
    </tbody>
</table>

@if (User.IsInRole(RoleNames.Expert)
    && (Model.CurrentStage == WorkflowStageNames.Assigned
        || Model.CurrentStage == WorkflowStageNames.InProgress))
{
    <div class="card mt-4">
        <div class="card-header">
            Add Update
        </div>

        <div class="card-body">
            <form asp-action="AddUpdate" method="post">
                <input type="hidden"
                       name="CaseId"
                       value="@Model.Id" />

                <div class="mb-3">
                    <label class="form-label">
                        Update
                    </label>

                    <textarea name="UpdateText"
                              class="form-control"
                              rows="3"
                              required></textarea>
                </div>

                <button class="btn btn-primary"
                        type="submit">
                    Save Update
                </button>
            </form>
        </div>
    </div>
}

<div class="mt-4">
    <h4>Updates</h4>

    @foreach (var update in Model.Updates)
    {
        <div class="border rounded p-2 mb-2">
            <strong>@update.UserName</strong>
            <small class="ms-2">
                @update.CreatedAt
            </small>

            <div>
                @update.UpdateText
            </div>
        </div>
    }
</div>

@if (User.IsInRole(RoleNames.Expert)
    && Model.CurrentStage == WorkflowStageNames.InProgress)
{
    <div class="card mt-4">
        <div class="card-header">
            Start Challenge
        </div>

        <div class="card-body">
            <form asp-action="StartChallenge" method="post">
                <input type="hidden"
                       name="CaseId"
                       value="@Model.Id" />

                <div class="mb-3">
                    <label class="form-label">
                        Challenge Reason
                    </label>

                    <textarea name="Reason"
                              class="form-control"
                              rows="3"
                              required></textarea>
                </div>

                <button class="btn btn-warning"
                        type="submit">
                    I Have a Challenge
                </button>
            </form>
        </div>
    </div>
}

@if (User.IsInRole(RoleNames.Supervisor)
    && Model.CurrentStage == WorkflowStageNames.Challenge)
{
    <div class="card mt-4">
        <div class="card-header">
            Resolve Challenge
        </div>

        <div class="card-body">
            <form asp-action="ResolveChallenge" method="post">
                <input type="hidden"
                       name="CaseId"
                       value="@Model.Id" />

                <div class="mb-3">
                    <label class="form-label">
                        Supervisor Comment
                    </label>

                    <textarea name="SupervisorComment"
                              class="form-control"
                              rows="3"
                              required></textarea>
                </div>

                <button class="btn btn-success"
                        type="submit">
                    Resolve Challenge
                </button>
            </form>
        </div>
    </div>
}

@if (User.IsInRole(RoleNames.Expert)
    && Model.CurrentStage == WorkflowStageNames.InProgress)
{
    <div class="card mt-4">
        <div class="card-header">
            Submit Completion
        </div>

        <div class="card-body">
            <form asp-action="SubmitCompletion"
                  method="post">

                <input type="hidden"
                       name="CaseId"
                       value="@Model.Id" />

                <div class="mb-3">
                    <label class="form-label">
                        Completion Summary
                    </label>

                    <textarea name="CompletionSummary"
                              class="form-control"
                              rows="4"
                              required></textarea>
                </div>

                <button type="submit"
                        class="btn btn-success">
                    Submit Completion
                </button>
            </form>
        </div>
    </div>
}

@if (User.IsInRole(RoleNames.Supervisor)
    && Model.CurrentStage == WorkflowStageNames.CompletionPending)
{
    <div class="card mt-4">
        <div class="card-header">
            Supervisor Completion Review
        </div>

        <div class="card-body">

            <form asp-action="ApproveCompletion"
                  method="post"
                  class="mb-3">

                <input type="hidden"
                       name="caseId"
                       value="@Model.Id" />

                <button type="submit"
                        class="btn btn-success">
                    Approve Completion
                </button>
            </form>

            <form asp-action="ReturnToWork"
                  method="post">

                <input type="hidden"
                       name="caseId"
                       value="@Model.Id" />

                <div class="mb-3">
                    <label class="form-label">
                        Return Reason
                    </label>

                    <textarea name="reason"
                              class="form-control"
                              rows="3"
                              required></textarea>
                </div>

                <button type="submit"
                        class="btn btn-warning">
                    Return to Work
                </button>
            </form>

        </div>
    </div>
}