@using CaseManagementSystem.Constants
@using System.Globalization
@model CaseManagementSystem.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";


    // =========================================================
    // HELPERS
    // =========================================================

    double Percent(int value)
    {
        if (Model.TotalCases == 0)
        {
            return 0;
        }

        return value * 100.0 /
               Model.TotalCases;
    }


    string PercentageText(int value)
    {
        return $"{Percent(value):0.#}%";
    }


    string CssNumber(double value)
    {
        return value.ToString(
            "0.##",
            CultureInfo.InvariantCulture
        );
    }


    string PriorityLabel(string priority)
    {
        return priority switch
        {
            "P1" => "Critical",
            "P2" => "High",
            "P3" => "Medium",
            "P4" => "Low",
            _ => priority
        };
    }


    string PriorityClass(string priority)
    {
        return priority switch
        {
            "P1" => "dash-priority-p1",
            "P2" => "dash-priority-p2",
            "P3" => "dash-priority-p3",
            "P4" => "dash-priority-p4",
            _ => "dash-priority-default"
        };
    }


    string StageLabel(string stage)
    {
        return stage switch
        {
            WorkflowStageNames.Assigned =>
                "Assigned",

            WorkflowStageNames.InProgress =>
                "In Progress",

            WorkflowStageNames.Challenge =>
                "Challenge",

            WorkflowStageNames.CompletionPending =>
                "Completion Pending",

            WorkflowStageNames.Completed =>
                "Completed",

            _ =>
                stage
        };
    }


    string StageClass(string stage)
    {
        return stage switch
        {
            WorkflowStageNames.Assigned =>
                "dash-stage-assigned",

            WorkflowStageNames.InProgress =>
                "dash-stage-progress",

            WorkflowStageNames.Challenge =>
                "dash-stage-challenge",

            WorkflowStageNames.CompletionPending =>
                "dash-stage-pending",

            WorkflowStageNames.Completed =>
                "dash-stage-completed",

            _ =>
                "dash-stage-default"
        };
    }


    string FormatDate(DateTime? date)
    {
        if (!date.HasValue)
        {
            return "—";
        }

        return date.Value.ToString(
            "dd MMM yyyy",
            CultureInfo.InvariantCulture
        );
    }

    string FormatTime(DateTime? date)
    {
        if (!date.HasValue)
        {
            return "—";
        }

        return date.Value.ToString(
            "hh:mm tt",
            CultureInfo.InvariantCulture
        );
    }


    // =========================================================
    // WORKFLOW DONUT
    // =========================================================

    var assignedEnd =
        Percent(Model.AssignedCount);

    var progressEnd =
        assignedEnd +
        Percent(Model.InProgressCount);

    var challengeEnd =
        progressEnd +
        Percent(Model.ChallengeCount);

    var pendingEnd =
        challengeEnd +
        Percent(Model.CompletionPendingCount);


    var workflowGradient =
        Model.TotalCases == 0
            ? "background:#edf1f3;"
            : $@"background:conic-gradient(
                #2e7ed7 0 {CssNumber(assignedEnd)}%,
                #38a7c4 {CssNumber(assignedEnd)}% {CssNumber(progressEnd)}%,
                #7556c5 {CssNumber(progressEnd)}% {CssNumber(challengeEnd)}%,
                #d99a24 {CssNumber(challengeEnd)}% {CssNumber(pendingEnd)}%,
                #2e8b57 {CssNumber(pendingEnd)}% 100%
            );";


    // =========================================================
    // PRIORITY DONUT
    // =========================================================

    var p1End =
        Percent(Model.P1Count);

    var p2End =
        p1End +
        Percent(Model.P2Count);

    var p3End =
        p2End +
        Percent(Model.P3Count);


    var priorityGradient =
        Model.TotalCases == 0
            ? "background:#edf1f3;"
            : $@"background:conic-gradient(
                #c84343 0 {CssNumber(p1End)}%,
                #d98a20 {CssNumber(p1End)}% {CssNumber(p2End)}%,
                #2e7ed7 {CssNumber(p2End)}% {CssNumber(p3End)}%,
                #2e8b57 {CssNumber(p3End)}% 100%
            );";


    // =========================================================
    // SLA DONUT
    // =========================================================

    var onTrackPercentage =
        Percent(Model.OnTrackCount);


    var slaGradient =
        Model.TotalCases == 0
            ? "background:#edf1f3;"
            : $@"background:conic-gradient(
                #2e8b57 0 {CssNumber(onTrackPercentage)}%,
                #c84343 {CssNumber(onTrackPercentage)}% 100%
            );";


    // =========================================================
    // PAGINATION
    // =========================================================

    var firstResult =
        Model.TotalCases == 0
            ? 0
            : ((Model.CurrentPage - 1) *
               Model.PageSize) + 1;


    var lastResult =
        Math.Min(
            Model.CurrentPage *
            Model.PageSize,
            Model.TotalCases
        );


    var pageStart =
        Math.Max(
            1,
            Model.CurrentPage - 2
        );


    var pageEnd =
        Math.Min(
            Model.PageCount,
            Model.CurrentPage + 2
        );
}


<div class="dash-workspace">


    <!-- =====================================================
         PAGE HEADER
         ===================================================== -->

    <div class="dash-page-header">


        <div>


            <h1>
                @(Model.IsSupervisor
                    ? "Dashboard Overview"
                    : "My Dashboard")
            </h1>


            <p>

                @if (Model.IsSupervisor)
                {
                    <text>
                        Monitor case performance, team workload, workflow status, and SLA compliance.
                    </text>
                }
                else
                {
                    <text>
                        Monitor your case performance, workflow status, priorities, and SLA compliance.
                    </text>
                }

            </p>


        </div>


        <div class="dash-current-date">


            <svg viewBox="0 0 24 24">

                <rect x="3"
                      y="5"
                      width="18"
                      height="16"
                      rx="2">
                </rect>

                <path d="M8 3v4">
                </path>

                <path d="M16 3v4">
                </path>

                <path d="M3 10h18">
                </path>

            </svg>


            @DateTime.Now.ToString(
                "dd MMM yyyy",
                CultureInfo.InvariantCulture
            )


        </div>


    </div>



    <!-- =====================================================
         FILTERS
         ===================================================== -->

    <form method="get"
          asp-controller="Dashboard"
          asp-action="Index"
          class="dash-filter-card">


        <div class="dash-filter-grid @(Model.IsSupervisor ? "" : "dash-filter-grid-expert")">


            <!-- DATE RANGE -->

            <div class="dash-filter-group dash-date-range">


                <label>
                    Date Range
                    <span>
                        (SLA Start Date)
                    </span>
                </label>


                <div class="dash-date-inputs">


                    <input type="date"
                           name="fromDate"
                           value="@Model.FromDate?.ToString("yyyy-MM-dd")"
                           aria-label="From date" />


                    <span>
                        —
                    </span>


                    <input type="date"
                           name="toDate"
                           value="@Model.ToDate?.ToString("yyyy-MM-dd")"
                           aria-label="To date" />


                </div>


            </div>



            <!-- EXPERT -->
            @if (Model.IsSupervisor)
            {

                <div class="dash-filter-group">


                    <label>
                        Expert
                    </label>


                    <select name="expertId">


                        <option value=""
                                selected="@string.IsNullOrWhiteSpace(Model.SelectedExpertId)">

                            All Experts

                        </option>


                        @foreach (var expert in Model.Experts)
                        {

                            <option value="@expert.Id"
                                    selected="@(expert.Id == Model.SelectedExpertId)">

                                @expert.FullName (@expert.EmployeeNumber)

                            </option>

                        }


                    </select>


                </div>

            }



            <!-- STAGE -->

            <div class="dash-filter-group">


                <label>
                    Stage
                </label>


                <select name="stage">


                    <option value="All"
                            selected="@(Model.SelectedStage == "All")">
                        All Stages
                    </option>


                    <option value="@WorkflowStageNames.Assigned"
                            selected="@(Model.SelectedStage == WorkflowStageNames.Assigned)">
                        Assigned
                    </option>


                    <option value="@WorkflowStageNames.InProgress"
                            selected="@(Model.SelectedStage == WorkflowStageNames.InProgress)">
                        In Progress
                    </option>


                    <option value="@WorkflowStageNames.Challenge"
                            selected="@(Model.SelectedStage == WorkflowStageNames.Challenge)">
                        Challenge
                    </option>


                    <option value="@WorkflowStageNames.CompletionPending"
                            selected="@(Model.SelectedStage == WorkflowStageNames.CompletionPending)">
                        Completion Pending
                    </option>


                    <option value="@WorkflowStageNames.Completed"
                            selected="@(Model.SelectedStage == WorkflowStageNames.Completed)">
                        Completed
                    </option>


                </select>


            </div>



            <!-- PRIORITY -->

            <div class="dash-filter-group">


                <label>
                    Priority
                </label>


                <select name="priority">


                    <option value="All"
                            selected="@(Model.SelectedPriority == "All")">
                        All Priorities
                    </option>


                    <option value="P1"
                            selected="@(Model.SelectedPriority == "P1")">
                        P1 - Critical
                    </option>


                    <option value="P2"
                            selected="@(Model.SelectedPriority == "P2")">
                        P2 - High
                    </option>


                    <option value="P3"
                            selected="@(Model.SelectedPriority == "P3")">
                        P3 - Medium
                    </option>


                    <option value="P4"
                            selected="@(Model.SelectedPriority == "P4")">
                        P4 - Low
                    </option>


                </select>


            </div>



            <!-- SLA -->

            <div class="dash-filter-group">


                <label>
                    SLA Status
                </label>


                <select name="slaStatus">


                    <option value="All"
                            selected="@(Model.SelectedSlaStatus == "All")">
                        All
                    </option>


                    <option value="OnTrack"
                            selected="@(Model.SelectedSlaStatus == "OnTrack")">
                        On Track
                    </option>


                    <option value="Delayed"
                            selected="@(Model.SelectedSlaStatus == "Delayed")">
                        Delayed
                    </option>


                </select>


            </div>



            <input type="hidden"
                   name="pageSize"
                   value="@Model.PageSize" />



            <!-- APPLY -->

            <button type="submit"
                    class="dash-apply-button">


                <svg viewBox="0 0 24 24">

                    <circle cx="11"
                            cy="11"
                            r="7">
                    </circle>

                    <path d="M20 20l-4-4">
                    </path>

                </svg>


                Apply Filters


            </button>



            <!-- RESET -->

            <a asp-controller="Dashboard"
               asp-action="Index"
               class="dash-reset-button">


                <svg viewBox="0 0 24 24">

                    <path d="M4 4v6h6">
                    </path>

                    <path d="M5.5 15a7 7 0 1 0 1.5-7">
                    </path>

                </svg>


                Reset


            </a>


        </div>


        <div class="dash-filter-note">


            <svg viewBox="0 0 24 24">

                <circle cx="12"
                        cy="12"
                        r="9">
                </circle>

                <path d="M12 11v5">
                </path>

                <path d="M12 8h.01">
                </path>

            </svg>


            All Dashboard metrics reflect the selected filters.


        </div>


    </form>



    <!-- =====================================================
         KPI CARDS
         ===================================================== -->

    <section class="dash-kpi-grid">


        <!-- TOTAL -->

        <article class="dash-kpi-card">


            <span class="dash-kpi-icon dash-kpi-blue">


                <svg viewBox="0 0 24 24">

                    <path d="M4 7h6l2 2h8v10H4z">
                    </path>

                </svg>


            </span>


            <div>


                <span>
                    @(Model.IsSupervisor
                        ? "Total Cases"
                        : "My Cases")
                </span>


                <strong>
                    @Model.TotalCases
                </strong>


                <small>
                    Filtered result
                </small>


            </div>


        </article>



        <!-- IN PROGRESS -->

        <article class="dash-kpi-card">


            <span class="dash-kpi-icon dash-kpi-cyan">


                <svg viewBox="0 0 24 24">

                    <circle cx="12"
                            cy="12"
                            r="9">
                    </circle>

                    <path d="M12 7v5l3 2">
                    </path>

                </svg>


            </span>


            <div>


                <span>
                    In Progress
                </span>


                <strong>
                    @Model.InProgressCount
                </strong>


                <small>
                    Active cases
                </small>


            </div>


        </article>



        <!-- CHALLENGE -->

        <article class="dash-kpi-card">


            <span class="dash-kpi-icon dash-kpi-purple">


                <svg viewBox="0 0 24 24">

                    <path d="M5 21V4">
                    </path>

                    <path d="M5 5h12l-2 4 2 4H5">
                    </path>

                </svg>


            </span>


            <div>


                <span>
                    Challenge
                </span>


                <strong>
                    @Model.ChallengeCount
                </strong>


                <small>
                    Challenged cases
                </small>


            </div>


        </article>



        <!-- DELAYED -->

        <article class="dash-kpi-card">


            <span class="dash-kpi-icon dash-kpi-red">


                <svg viewBox="0 0 24 24">

                    <circle cx="12"
                            cy="12"
                            r="9">
                    </circle>

                    <path d="M12 7v5">
                    </path>

                    <path d="M12 16h.01">
                    </path>

                </svg>


            </span>


            <div>


                <span>
                    Delayed
                </span>


                <strong>
                    @Model.DelayedCount
                </strong>


                <small>
                    SLA breached
                </small>


            </div>


        </article>



        <!-- COMPLETED -->

        <article class="dash-kpi-card">


            <span class="dash-kpi-icon dash-kpi-green">


                <svg viewBox="0 0 24 24">

                    <circle cx="12"
                            cy="12"
                            r="9">
                    </circle>

                    <path d="M8 12l3 3 5-6">
                    </path>

                </svg>


            </span>


            <div>


                <span>
                    Completed
                </span>


                <strong>
                    @Model.CompletedCount
                </strong>


                <small>
                    Completed cases
                </small>


            </div>


        </article>


    </section>



    <!-- =====================================================
         ANALYTICS
         ===================================================== -->

    <section class="dash-analytics-grid">


        <!-- =================================================
             WORKFLOW
             ================================================= -->

        <article class="dash-analytics-card">


            <header>
                <h2>
                    Workflow Status
                </h2>

                <span>
                    by Stage
                </span>
            </header>


            <div class="dash-chart-layout">


                <div class="dash-donut"
                     style="@workflowGradient">


                    <div class="dash-donut-center">

                        <strong>
                            @Model.TotalCases
                        </strong>

                        <span>
                            Total
                        </span>

                    </div>


                </div>



                <div class="dash-legend">


                    <div>

                        <span class="dash-dot dash-dot-blue"></span>

                        <span>
                            Assigned
                        </span>

                        <strong>
                            @Model.AssignedCount
                            (@PercentageText(Model.AssignedCount))
                        </strong>

                    </div>


                    <div>

                        <span class="dash-dot dash-dot-cyan"></span>

                        <span>
                            In Progress
                        </span>

                        <strong>
                            @Model.InProgressCount
                            (@PercentageText(Model.InProgressCount))
                        </strong>

                    </div>


                    <div>

                        <span class="dash-dot dash-dot-purple"></span>

                        <span>
                            Challenge
                        </span>

                        <strong>
                            @Model.ChallengeCount
                            (@PercentageText(Model.ChallengeCount))
                        </strong>

                    </div>


                    <div>

                        <span class="dash-dot dash-dot-orange"></span>

                        <span>
                            Completion Pending
                        </span>

                        <strong>
                            @Model.CompletionPendingCount
                            (@PercentageText(Model.CompletionPendingCount))
                        </strong>

                    </div>


                    <div>

                        <span class="dash-dot dash-dot-green"></span>

                        <span>
                            Completed
                        </span>

                        <strong>
                            @Model.CompletedCount
                            (@PercentageText(Model.CompletedCount))
                        </strong>

                    </div>


                </div>


            </div>


            <footer>
                Distribution by workflow stage after current filters.
            </footer>


        </article>



        <!-- =================================================
             PRIORITY
             ================================================= -->

        <article class="dash-analytics-card">


            <header>
                <h2>
                    Cases by Priority
                </h2>
            </header>


            <div class="dash-chart-layout">


                <div class="dash-donut"
                     style="@priorityGradient">


                    <div class="dash-donut-center">

                        <strong>
                            @Model.TotalCases
                        </strong>

                        <span>
                            Total
                        </span>

                    </div>


                </div>



                <div class="dash-legend">


                    <div>

                        <span class="dash-dot dash-dot-red"></span>

                        <span>
                            P1 - Critical
                        </span>

                        <strong>
                            @Model.P1Count
                            (@PercentageText(Model.P1Count))
                        </strong>

                    </div>


                    <div>

                        <span class="dash-dot dash-dot-orange"></span>

                        <span>
                            P2 - High
                        </span>

                        <strong>
                            @Model.P2Count
                            (@PercentageText(Model.P2Count))
                        </strong>

                    </div>


                    <div>

                        <span class="dash-dot dash-dot-blue"></span>

                        <span>
                            P3 - Medium
                        </span>

                        <strong>
                            @Model.P3Count
                            (@PercentageText(Model.P3Count))
                        </strong>

                    </div>


                    <div>

                        <span class="dash-dot dash-dot-green"></span>

                        <span>
                            P4 - Low
                        </span>

                        <strong>
                            @Model.P4Count
                            (@PercentageText(Model.P4Count))
                        </strong>

                    </div>


                </div>


            </div>


            <footer>
                Priority distribution after current filters.
            </footer>


        </article>



        <!-- =================================================
             SLA
             ================================================= -->

        <article class="dash-analytics-card">


            <header>

                <h2>
                    SLA Monitoring
                </h2>

            </header>


            <div class="dash-chart-layout">


                <div class="dash-donut"
                     style="@slaGradient">


                    <div class="dash-donut-center">


                        <strong>
                            @Model.CompliancePercentage.ToString("0.#")%
                        </strong>


                        <span>
                            Compliance
                        </span>


                    </div>


                </div>



                <div class="dash-legend">


                    <div>

                        <span class="dash-dot dash-dot-green"></span>

                        <span>
                            On Track
                        </span>

                        <strong>
                            @Model.OnTrackCount
                            (@PercentageText(Model.OnTrackCount))
                        </strong>

                    </div>


                    <div>

                        <span class="dash-dot dash-dot-red"></span>

                        <span>
                            Delayed
                        </span>

                        <strong>
                            @Model.DelayedCount
                            (@PercentageText(Model.DelayedCount))
                        </strong>

                    </div>


                </div>


            </div>


            <footer class="dash-sla-formula">

                Compliance =
                On Track ÷ Filtered Cases

            </footer>


        </article>


    </section>



    <!-- =====================================================
         BOTTOM SECTION
         ===================================================== -->

    <section class="@(Model.IsSupervisor ? "dash-bottom-grid" : "dash-bottom-single")">


        <!-- =================================================
             EXPERT WORKLOAD - SUPERVISOR ONLY
             ================================================= -->
        @if (Model.IsSupervisor)
        {

            <article class="dash-table-card dash-workload-card">


                <header class="dash-card-header">


                    <div>


                        <h2>
                            Expert Workload
                        </h2>


                        <span>
                            Filtered
                        </span>


                    </div>


                </header>



                <div class="table-responsive">


                    <table class="dash-table dash-workload-table">


                        <thead>


                            <tr>

                                <th>
                                    Expert
                                </th>

                                <th>
                                    Active
                                </th>

                                <th>
                                    In Progress
                                </th>

                                <th>
                                    Challenge
                                </th>

                                <th>
                                    Completed
                                </th>

                                <th>
                                    Delayed
                                </th>

                            </tr>


                        </thead>



                        <tbody>


                            @if (Model.ExpertWorkload.Any())
                            {

                                @foreach (var expert in Model.ExpertWorkload)
                                {

                                    <tr>


                                        <td>


                                            <div class="dash-expert">


                                                <span class="dash-expert-avatar">

                                                    @(
                                                        string.IsNullOrWhiteSpace(expert.ExpertName)
                                                            ? "E"
                                                            : expert.ExpertName.Substring(0, 1).ToUpperInvariant()
                                                    )

                                                </span>


                                                <div>

                                                    <strong>
                                                        @expert.ExpertName
                                                    </strong>

                                                    <span>
                                                        @expert.EmployeeNumber
                                                    </span>

                                                </div>


                                            </div>


                                        </td>


                                        <td>
                                            <strong>
                                                @expert.ActiveCount
                                            </strong>
                                        </td>


                                        <td>
                                            @expert.InProgressCount
                                        </td>


                                        <td>
                                            @expert.ChallengeCount
                                        </td>


                                        <td>
                                            @expert.CompletedCount
                                        </td>


                                        <td>


                                            <span class="@(expert.DelayedCount > 0 ? "dash-workload-delayed" : "")">

                                                @expert.DelayedCount

                                            </span>


                                        </td>


                                    </tr>

                                }

                            }
                            else
                            {

                                <tr>

                                    <td colspan="6"
                                        class="dash-empty-cell">

                                        No Experts match the selected filters.

                                    </td>

                                </tr>

                            }


                        </tbody>


                    </table>


                </div>


                <footer class="dash-workload-note">

                    Active = all filtered cases except Completed.

                </footer>


            </article>

        }



        <!-- =================================================
             CASE PERFORMANCE
             ================================================= -->

        <article class="dash-table-card dash-performance-card">


            <header class="dash-card-header">


                <div>


                    <h2>
                        Case Performance
                    </h2>


                    <span>
                        Filtered
                    </span>


                </div>


            </header>



            @if (Model.Cases.Any())
            {

                <div class="table-responsive">


                    <table class="dash-table dash-case-table">


                        <thead>


                            <tr>

                                <th>
                                    Case
                                </th>

                                <th>
                                    Title
                                </th>

                                <th>
                                    Priority
                                </th>

                                <th>
                                    Stage
                                </th>


                                @if (Model.IsSupervisor)
                                {
                                    <th>
                                        Expert
                                    </th>
                                }


                                <th>
                                    Due Date
                                </th>

                                <th>
                                    SLA
                                </th>

                                <th>
                                    Action
                                </th>

                            </tr>


                        </thead>



                        <tbody>


                            @foreach (var item in Model.Cases)
                            {

                                <tr>


                                    <!-- CASE -->

                                    <td>


                                        <strong class="dash-case-id">
                                            @item.ExternalCaseId
                                        </strong>


                                    </td>



                                    <!-- TITLE -->

                                    <td>


                                        <span class="dash-case-title">
                                            @item.Title
                                        </span>


                                    </td>



                                    <!-- PRIORITY -->

                                    <td>


                                        <span class="dash-badge @PriorityClass(item.Priority)">

                                            @item.Priority -
                                            @PriorityLabel(item.Priority)

                                        </span>


                                    </td>



                                    <!-- STAGE -->

                                    <td>


                                        <span class="dash-stage @StageClass(item.CurrentStage)">


                                            <span></span>


                                            @StageLabel(item.CurrentStage)


                                        </span>


                                    </td>



                                    <!-- EXPERT -->
                                    @if (Model.IsSupervisor)
                                    {

                                        <td>


                                            @(string.IsNullOrWhiteSpace(item.AssignedExpert)
                                                ? "—"
                                                : item.AssignedExpert)


                                        </td>

                                    }



                                    <!-- DUE DATE -->

                                    <td>


                                        <div class="dash-due @(item.IsDelayed ? "dash-due-delayed" : "")">


                                            <strong>
                                                @FormatDate(item.DueDate)
                                            </strong>


                                            <span>
                                                @FormatTime(item.DueDate)
                                            </span>


                                        </div>


                                    </td>



                                    <!-- SLA -->

                                    <td>


                                        @if (item.IsDelayed)
                                        {

                                            <span class="dash-sla-badge dash-sla-delayed">
                                                Delayed
                                            </span>

                                        }
                                        else
                                        {

                                            <span class="dash-sla-badge dash-sla-track">
                                                On Track
                                            </span>

                                        }


                                    </td>



                                    <!-- ACTION -->

                                    <td>


                                        <a asp-controller="Cases"
                                           asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="dash-view-button">

                                            View

                                        </a>


                                    </td>


                                </tr>

                            }


                        </tbody>


                    </table>


                </div>

            }
            else
            {

                <div class="dash-empty-state">


                    <svg viewBox="0 0 24 24">

                        <circle cx="11"
                                cy="11"
                                r="7">
                        </circle>

                        <path d="M20 20l-4-4">
                        </path>

                    </svg>


                    <strong>
                        No cases found
                    </strong>


                    <span>
                        No Cases match the selected Dashboard filters.
                    </span>


                </div>

            }



            <!-- =================================================
                 TABLE FOOTER
                 ================================================= -->

            <footer class="dash-table-footer">


                <span>

                    Showing @firstResult to @lastResult
                    of @Model.TotalCases results

                </span>



                <div class="dash-pagination">


                    @if (Model.PageCount > 1)
                    {

                        <!-- PREVIOUS -->

                        <a asp-action="Index"
                           asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
                           asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")"
                           asp-route-expertId="@Model.SelectedExpertId"
                           asp-route-stage="@Model.SelectedStage"
                           asp-route-priority="@Model.SelectedPriority"
                           asp-route-slaStatus="@Model.SelectedSlaStatus"
                           asp-route-page="@(Math.Max(1, Model.CurrentPage - 1))"
                           asp-route-pageSize="@Model.PageSize"
                           class="@(Model.CurrentPage == 1 ? "disabled" : "")">

                            ‹

                        </a>


                        @for (var pageNumber = pageStart;
                             pageNumber <= pageEnd;
                             pageNumber++)
                        {

                            <a asp-action="Index"
                               asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
                               asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")"
                               asp-route-expertId="@Model.SelectedExpertId"
                               asp-route-stage="@Model.SelectedStage"
                               asp-route-priority="@Model.SelectedPriority"
                               asp-route-slaStatus="@Model.SelectedSlaStatus"
                               asp-route-page="@pageNumber"
                               asp-route-pageSize="@Model.PageSize"
                               class="@(pageNumber == Model.CurrentPage ? "active" : "")">

                                @pageNumber

                            </a>

                        }


                        <!-- NEXT -->

                        <a asp-action="Index"
                           asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
                           asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")"
                           asp-route-expertId="@Model.SelectedExpertId"
                           asp-route-stage="@Model.SelectedStage"
                           asp-route-priority="@Model.SelectedPriority"
                           asp-route-slaStatus="@Model.SelectedSlaStatus"
                           asp-route-page="@(Math.Min(Model.PageCount, Model.CurrentPage + 1))"
                           asp-route-pageSize="@Model.PageSize"
                           class="@(Model.CurrentPage == Model.PageCount ? "disabled" : "")">

                            ›

                        </a>

                    }


                </div>



                <!-- PAGE SIZE -->

                <form method="get"
                      asp-controller="Dashboard"
                      asp-action="Index"
                      class="dash-page-size-form">


                    <input type="hidden"
                           name="fromDate"
                           value="@Model.FromDate?.ToString("yyyy-MM-dd")" />


                    <input type="hidden"
                           name="toDate"
                           value="@Model.ToDate?.ToString("yyyy-MM-dd")" />


                    <input type="hidden"
                           name="expertId"
                           value="@Model.SelectedExpertId" />


                    <input type="hidden"
                           name="stage"
                           value="@Model.SelectedStage" />


                    <input type="hidden"
                           name="priority"
                           value="@Model.SelectedPriority" />


                    <input type="hidden"
                           name="slaStatus"
                           value="@Model.SelectedSlaStatus" />


                    <input type="hidden"
                           name="page"
                           value="1" />


                    <label>

                        Rows per page:


                        <select name="pageSize"
                                onchange="this.form.submit()">


                            <option value="5"
                                    selected="@(Model.PageSize == 5)">
                                5
                            </option>


                            <option value="10"
                                    selected="@(Model.PageSize == 10)">
                                10
                            </option>


                            <option value="20"
                                    selected="@(Model.PageSize == 20)">
                                20
                            </option>


                            <option value="50"
                                    selected="@(Model.PageSize == 50)">
                                50
                            </option>


                        </select>


                    </label>


                </form>


            </footer>


        </article>


    </section>



    <!-- =====================================================
         DASHBOARD FOOTNOTE
         ===================================================== -->

    <div class="dash-footnote">


        <span>
            Dashboard statistics are calculated from current filtered case data.
        </span>


        <span>
            Last refreshed:
            @DateTime.Now.ToString(
                "dd MMM yyyy · hh:mm tt",
                CultureInfo.InvariantCulture
            )
        </span>


    </div>


</div>