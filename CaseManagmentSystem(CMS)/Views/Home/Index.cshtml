                                        cy="12"
                                        r="9">
                                </circle>

                                <path d="M12 7v5">
                                </path>

                                <path d="M12 16h.01">
                                </path>

                            </svg>


                        </span>


                        <span class="home-operation-copy">


                            <strong>
                                Delayed
                            </strong>


                            <small>
                                Your cases that have exceeded their SLA
                            </small>


                        </span>


                        <strong class="home-operation-number home-number-red">

                            @Model.DelayedCount

                        </strong>


                        <svg class="home-operation-arrow"
                             viewBox="0 0 24 24">

                            <path d="M9 5l7 7-7 7">
                            </path>

                        </svg>


                    </a>


                </div>


            </article>



            <!-- =============================================
                 MY WORK SUMMARY
                 ============================================= -->

            <article class="home-panel">


                <header class="home-panel-header">


                    <div>

                        <h2>
                            My Work Summary
                        </h2>

                    </div>


                </header>



                <div class="home-operation-list">


                    <!-- ACTIVE -->

                    <a asp-controller="Cases"
                       asp-action="MyCases"
                       class="home-operation-item">


                        <span class="home-operation-icon home-operation-cyan">


                            <svg viewBox="0 0 24 24">

                                <path d="M4 7h6l2 2h8v10H4z">
                                </path>

                            </svg>


                        </span>


                        <span class="home-operation-copy">


                            <strong>
                                Active Cases
                            </strong>


                            <small>
                                Cases that are not yet completed
                            </small>


                        </span>


                        <strong class="home-operation-number home-number-cyan">

                            @activeCasesCount

                        </strong>


                        <svg class="home-operation-arrow"
                             viewBox="0 0 24 24">

                            <path d="M9 5l7 7-7 7">
                            </path>

                        </svg>


                    </a>



                    <!-- HIGH PRIORITY -->

                    <a asp-controller="Cases"
                       asp-action="MyCases"
                       class="home-operation-item">


                        <span class="home-operation-icon home-operation-red">


                            <svg viewBox="0 0 24 24">

                                <path d="M12 3l9 18H3z">
                                </path>

                                <path d="M12 9v5">
                                </path>

                                <path d="M12 17h.01">
                                </path>

                            </svg>


                        </span>


                        <span class="home-operation-copy">


                            <strong>
                                High Priority
                            </strong>


                            <small>
                                P1 and P2 cases assigned to you
                            </small>


                        </span>


                        <strong class="home-operation-number home-number-red">

                            @highPriorityCount

                        </strong>


                        <svg class="home-operation-arrow"
                             viewBox="0 0 24 24">

                            <path d="M9 5l7 7-7 7">
                            </path>

                        </svg>


                    </a>



                    <!-- COMPLETION PENDING -->

                    <a asp-controller="Cases"
                       asp-action="MyCases"
                       class="home-operation-item">


                        <span class="home-operation-icon home-operation-orange">


                            <svg viewBox="0 0 24 24">

                                <circle cx="12"
                                        cy="12"
                                        r="9">
                                </circle>

                                <path d="M12 7v5">
                                </path>

                                <path d="M12 16h.01">
                                </path>

                            </svg>


                        </span>


                        <span class="home-operation-copy">


                            <strong>
                                Completion Pending
                            </strong>


                            <small>
                                Submitted and waiting for supervisor review
                            </small>


                        </span>


                        <strong class="home-operation-number home-number-orange">

                            @completionPendingCount

                        </strong>


                        <svg class="home-operation-arrow"
                             viewBox="0 0 24 24">

                            <path d="M9 5l7 7-7 7">
                            </path>

                        </svg>


                    </a>



                    <!-- COMPLETED -->

                    <a asp-controller="Cases"
                       asp-action="MyCases"
                       class="home-operation-item">


                        <span class="home-operation-icon home-operation-green">


                            <svg viewBox="0 0 24 24">

                                <circle cx="12"
                                        cy="12"
                                        r="9">
                                </circle>

                                <path d="M8 12l3 3 5-6">
                                </path>

                            </svg>


                        </span>


                        <span class="home-operation-copy">


                            <strong>
                                Completed
                            </strong>


                            <small>
                                Your completed cases
                            </small>


                        </span>


                        <strong class="home-operation-number home-number-green">

                            @Model.CompletedCount

                        </strong>


                        <svg class="home-operation-arrow"
                             viewBox="0 0 24 24">

                            <path d="M9 5l7 7-7 7">
                            </path>

                        </svg>


                    </a>


                </div>


            </article>


        </section>

    }



    <!-- =====================================================
         RECENT CASES
         ===================================================== -->

    <section class="home-recent-panel">


        <header class="home-panel-header">


            <div>

                <h2>
                    @(isSupervisor
                        ? "Recent Cases"
                        : "Recent My Cases")
                </h2>

            </div>



            <a asp-controller="Cases"
               asp-action="@(isSupervisor ? "Index" : "MyCases")"
               class="home-panel-link">


                View All


                <svg viewBox="0 0 24 24">

                    <path d="M5 12h14">
                    </path>

                    <path d="M13 6l6 6-6 6">
                    </path>

                </svg>


            </a>


        </header>



        @if (recentCases.Any())
        {

            <div class="table-responsive">


                <table class="home-recent-table">


                    <thead>


                        <tr>


                            <th>
                                Case
                            </th>


                            <th>
                                Title
                            </th>


                            <th>
                                Priority
                            </th>


                            <th>
                                Status
                            </th>


                            @if (isSupervisor)
                            {
                                <th>
                                    Expert
                                </th>
                            }


                            <th>
                                SLA Due
                            </th>


                            <th>
                                Action
                            </th>


                        </tr>


                    </thead>



                    <tbody>


                        @foreach (var item in recentCases)
                        {

                            <tr>


                                <!-- CASE -->

                                <td>


                                    <strong class="home-case-id">

                                        @item.ExternalCaseId

                                    </strong>


                                </td>



                                <!-- TITLE -->

                                <td>


                                    <span class="home-case-title">

                                        @item.Title

                                    </span>


                                </td>



                                <!-- PRIORITY -->

                                <td>


                                    <span class="home-status-badge @PriorityClass(item.Priority)">


                                        <span class="home-badge-dot">
                                        </span>


                                        @item.Priority
                                        @PriorityLabel(item.Priority)


                                    </span>


                                </td>



                                <!-- STATUS -->

                                <td>


                                    <span class="home-status-badge @StageClass(item.CurrentStage)">


                                        <span class="home-badge-dot">
                                        </span>


                                        @StageLabel(item.CurrentStage)


                                    </span>


                                </td>



                                <!-- EXPERT -->
                                @if (isSupervisor)
                                {

                                    <td>


                                        <span class="home-expert-name">

                                            @(string.IsNullOrWhiteSpace(
                                                item.AssignedExpert
                                            )
                                                ? "—"
                                                : item.AssignedExpert)

                                        </span>


                                    </td>

                                }



                                <!-- SLA -->

                                <td>


                                    <div class="home-due-date @(item.IsDelayed ? "home-due-delayed" : "")">


                                        <strong>
                                            @FormatDate(item.DueDate)
                                        </strong>


                                        <span>
                                            @FormatTime(item.DueDate)
                                        </span>


                                        @if (item.IsDelayed)
                                        {
                                            <small>
                                                Delayed
                                            </small>
                                        }


                                    </div>


                                </td>



                                <!-- ACTION -->

                                <td>


                                    <a asp-controller="Cases"
                                       asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="home-view-case">


                                        View


                                        <svg viewBox="0 0 24 24">

                                            <path d="M5 12h14">
                                            </path>

                                            <path d="M13 6l6 6-6 6">
                                            </path>

                                        </svg>


                                    </a>


                                </td>


                            </tr>

                        }


                    </tbody>


                </table>


            </div>

        }
        else
        {

            <div class="home-empty-state">


                <svg viewBox="0 0 24 24">

                    <path d="M4 7h6l2 2h8v10H4z">
                    </path>

                </svg>


                <strong>
                    No cases available
                </strong>


                <span>
                    There are no cases to display right now.
                </span>


            </div>

        }


    </section>


</div>