@using CaseManagementSystem.Constants
@model CaseManagementSystem.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Home";

    var isSupervisor = User.IsInRole(RoleNames.Supervisor);
    var isExpert = User.IsInRole(RoleNames.Expert);

    var attentionCases = Model.Cases
        .Where(x =>
            x.IsDelayed ||
            x.CurrentStage == WorkflowStageNames.Challenge)
        .Take(5)
        .ToList();

    var recentCases = Model.Cases
        .Take(5)
        .ToList();
}

<div class="mb-4">
    <h2 class="fw-bold mb-1">
        @if (isSupervisor)
        {
            <text>Case Management Overview</text>
        }
        else
        {
            <text>My Work Overview</text>
        }
    </h2>

    <p class="text-muted mb-0">
        Welcome, @User.Identity?.Name
    </p>
</div>

<!-- KPI Cards -->
<div class="row g-3 mb-4">

    <div class="col-xl col-md-4 col-sm-6">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <div class="text-muted small">
                    @(isSupervisor ? "Total Cases" : "My Cases")
                </div>

                <div class="fs-2 fw-bold">
                    @Model.TotalCases
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl col-md-4 col-sm-6">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <div class="text-muted small">
                    In Progress
                </div>

                <div class="fs-2 fw-bold">
                    @Model.InProgressCount
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl col-md-4 col-sm-6">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <div class="text-muted small">
                    Challenge
                </div>

                <div class="fs-2 fw-bold">
                    @Model.ChallengeCount
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl col-md-4 col-sm-6">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <div class="text-muted small">
                    Delayed
                </div>

                <div class="fs-2 fw-bold">
                    @Model.DelayedCount
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl col-md-4 col-sm-6">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <div class="text-muted small">
                    Completed
                </div>

                <div class="fs-2 fw-bold">
                    @Model.CompletedCount
                </div>
            </div>
        </div>
    </div>

</div>

<!-- Quick Actions -->
<div class="card shadow-sm mb-4">
    <div class="card-header bg-white fw-semibold">
        Quick Actions
    </div>

    <div class="card-body d-flex gap-2 flex-wrap">

        <a asp-controller="Dashboard"
           asp-action="Index"
           class="btn btn-primary">
            Open Dashboard
        </a>

        @if (isSupervisor)
        {
            <a asp-controller="Cases"
               asp-action="Index"
               class="btn btn-outline-primary">
                All Cases
            </a>

            <a asp-controller="Import"
               asp-action="Index"
               class="btn btn-outline-primary">
                Import Cases
            </a>

            <a asp-controller="Import"
               asp-action="Review"
               class="btn btn-outline-warning">
                Needs Review
            </a>

            <a asp-controller="Users"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Users
            </a>
        }

        @if (isExpert)
        {
            <a asp-controller="Cases"
               asp-action="MyCases"
               class="btn btn-outline-primary">
                My Cases
            </a>
        }

    </div>
</div>

<!-- Cases Requiring Attention -->
<div class="card shadow-sm mb-4">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <span class="fw-semibold">
            Cases Requiring Attention
        </span>

        <span class="badge bg-danger">
            @attentionCases.Count
        </span>
    </div>

    <div class="card-body p-0">

        @if (attentionCases.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>Case</th>
                            <th>Title</th>
                            <th>Priority</th>
                            <th>Status</th>

                            @if (isSupervisor)
                            {
                                <th>Expert</th>
                            }

                            <th>SLA</th>
                            <th></th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in attentionCases)
                        {
                            <tr>
                                <td class="fw-semibold">
                                    @item.ExternalCaseId
                                </td>

                                <td>
                                    @item.Title
                                </td>

                                <td>
                                    @item.Priority
                                </td>

                                <td>
                                    @item.CurrentStage
                                </td>

                                @if (isSupervisor)
                                {
                                    <td>
                                        @item.AssignedExpert
                                    </td>
                                }

                                <td>
                                    @if (item.IsDelayed)
                                    {
                                        <span class="badge bg-danger">
                                            Delayed
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Attention
                                        </span>
                                    }
                                </td>

                                <td class="text-end">
                                    <a asp-controller="Cases"
                                       asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        View
                                    </a>
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>
            </div>
        }
        else
        {
            <div class="p-4 text-center text-muted">
                No cases currently require attention.
            </div>
        }

    </div>
</div>

<!-- Recent Cases -->
<div class="card shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">

        <span class="fw-semibold">
            @(isSupervisor ? "Recent Cases" : "My Recent Cases")
        </span>

        @if (isSupervisor)
        {
            <a asp-controller="Cases"
               asp-action="Index"
               class="btn btn-sm btn-outline-secondary">
                View All
            </a>
        }
        else
        {
            <a asp-controller="Cases"
               asp-action="MyCases"
               class="btn btn-sm btn-outline-secondary">
                View All
            </a>
        }

    </div>

    <div class="card-body p-0">

        @if (recentCases.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>Case</th>
                            <th>Title</th>
                            <th>Priority</th>
                            <th>Status</th>

                            @if (isSupervisor)
                            {
                                <th>Expert</th>
                            }

                            <th>Due Date</th>
                            <th></th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in recentCases)
                        {
                            <tr>
                                <td class="fw-semibold">
                                    @item.ExternalCaseId
                                </td>

                                <td>
                                    @item.Title
                                </td>

                                <td>
                                    @item.Priority
                                </td>

                                <td>
                                    @item.CurrentStage
                                </td>

                                @if (isSupervisor)
                                {
                                    <td>
                                        @item.AssignedExpert
                                    </td>
                                }

                                <td>
                                    @(item.DueDate?.ToString("yyyy-MM-dd HH:mm") ?? "-")
                                </td>

                                <td class="text-end">
                                    <a asp-controller="Cases"
                                       asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        View
                                    </a>
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>
            </div>
        }
        else
        {
            <div class="p-4 text-center text-muted">
                No cases available.
            </div>
        }

    </div>
</div>