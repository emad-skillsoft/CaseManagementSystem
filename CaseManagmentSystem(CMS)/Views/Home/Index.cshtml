@using CaseManagementSystem.Constants
@using System.Globalization
@model CaseManagementSystem.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Home";


    var isSupervisor =
        User.IsInRole(RoleNames.Supervisor);


    var isExpert =
        User.IsInRole(RoleNames.Expert);


    var displayName =
        User.Identity?.Name
        ?? (isSupervisor ? "supervisor" : "expert");


    var needsReviewCount =
        ViewBag.NeedsReviewCount is int reviewCount
            ? reviewCount
            : 0;


    /*
     * ---------------------------------------------------------
     * WORKFLOW COUNTS
     * ---------------------------------------------------------
     */

    var assignedCount =
        Model.Cases.Count(
            x =>
                x.CurrentStage ==
                WorkflowStageNames.Assigned
        );


    var completionPendingCount =
        Model.Cases.Count(
            x =>
                x.CurrentStage ==
                WorkflowStageNames.CompletionPending
        );


    var highPriorityCount =
        Model.Cases.Count(
            x =>
                x.Priority == "P1" ||
                x.Priority == "P2"
        );


    var activeCasesCount =
        Model.Cases.Count(
            x =>
                x.CurrentStage !=
                WorkflowStageNames.Completed
        );


    /*
     * ---------------------------------------------------------
     * ATTENTION COUNTS
     * ---------------------------------------------------------
     */

    var supervisorCaseAttentionCount =
        Model.Cases.Count(
            x =>
                x.IsDelayed ||
                x.CurrentStage ==
                    WorkflowStageNames.Challenge ||
                x.CurrentStage ==
                    WorkflowStageNames.CompletionPending
        );


    var supervisorAttentionCount =
        supervisorCaseAttentionCount +
        needsReviewCount;


    var expertAttentionCount =
        Model.Cases.Count(
            x =>
                x.IsDelayed ||
                x.CurrentStage ==
                    WorkflowStageNames.Assigned ||
                x.CurrentStage ==
                    WorkflowStageNames.Challenge
        );


    /*
     * ---------------------------------------------------------
     * RECENT CASES
     * ---------------------------------------------------------
     */

    var recentCases =
        Model.Cases
            .Take(5)
            .ToList();


    /*
     * ---------------------------------------------------------
     * DATE FORMAT
     * ---------------------------------------------------------
     */

    string FormatDate(DateTime? date)
    {
        if (!date.HasValue)
        {
            return "—";
        }

        return date.Value.ToString(
            "dd MMM yyyy",
            CultureInfo.InvariantCulture
        );
    }


    string FormatTime(DateTime? date)
    {
        if (!date.HasValue)
        {
            return "—";
        }

        return date.Value.ToString(
            "hh:mm tt",
            CultureInfo.InvariantCulture
        );
    }


    /*
     * ---------------------------------------------------------
     * PRIORITY HELPERS
     * ---------------------------------------------------------
     */

    string PriorityLabel(string priority)
    {
        return priority switch
        {
            "P1" => "Critical",
            "P2" => "High",
            "P3" => "Medium",
            "P4" => "Low",
            _ => priority
        };
    }


    string PriorityClass(string priority)
    {
        return priority switch
        {
            "P1" => "home-priority-p1",
            "P2" => "home-priority-p2",
            "P3" => "home-priority-p3",
            "P4" => "home-priority-p4",
            _ => "home-priority-default"
        };
    }


    /*
     * ---------------------------------------------------------
     * STAGE HELPERS
     * ---------------------------------------------------------
     */

    string StageLabel(string stage)
    {
        return stage switch
        {
            WorkflowStageNames.Assigned =>
                "Assigned",

            WorkflowStageNames.InProgress =>
                "In Progress",

            WorkflowStageNames.Challenge =>
                "Challenge",

            WorkflowStageNames.CompletionPending =>
                "Completion Pending",

            WorkflowStageNames.Completed =>
                "Completed",

            _ =>
                stage
        };
    }


    string StageClass(string stage)
    {
        return stage switch
        {
            WorkflowStageNames.Assigned =>
                "home-stage-assigned",

            WorkflowStageNames.InProgress =>
                "home-stage-progress",

            WorkflowStageNames.Challenge =>
                "home-stage-challenge",

            WorkflowStageNames.CompletionPending =>
                "home-stage-pending",

            WorkflowStageNames.Completed =>
                "home-stage-completed",

            _ =>
                "home-stage-default"
        };
    }
}


