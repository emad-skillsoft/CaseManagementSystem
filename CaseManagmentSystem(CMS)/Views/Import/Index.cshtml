@model CaseManagementSystem.ViewModels.ExcelImportViewModel
@{
    ViewData["Title"] = "Excel Import";
}

<h2>Excel Import Preview</h2>

<form asp-action="Preview" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="ExcelFile" class="form-label">Excel File</label>
        <input asp-for="ExcelFile" type="file" accept=".xlsx" class="form-control" />
        <span asp-validation-for="ExcelFile" class="text-danger"></span>
    </div>

   <button type="submit" asp-action="Preview" class="btn btn-secondary">
    Validate & Preview
</button>

<button type="submit" asp-action="Import" class="btn btn-primary">
    Import Valid Rows
</button>

</form>
@if (Model.Result != null)
{
    <div class="card mt-4">
        <div class="card-header">
            Import Result
        </div>
        <div class="card-body">
            <div class="row text-center">
                <div class="col">
                    <strong>Total</strong>
                    <div>@Model.Result.TotalRows</div>
                </div>
                <div class="col">
                    <strong>Imported</strong>
                    <div>@Model.Result.Imported</div>
                </div>
                <div class="col">
                    <strong>Needs Review</strong>
                    <div>@Model.Result.NeedsReview</div>
                </div>
                <div class="col">
                    <strong>Invalid</strong>
                    <div>@Model.Result.Invalid</div>
                </div>
                <div class="col">
                    <strong>Duplicates</strong>
                    <div>@Model.Result.Duplicates</div>
                </div>
            </div>
        </div>
    </div>
}

@if (ViewBag.Message != null)
{
    <div class="alert alert-info mt-3">
        @ViewBag.Message
    </div>
}


@if (Model.Rows.Any())
{
    <hr />

    <div class="table-responsive">
        <table class="table table-bordered table-sm">
            <thead>
                <tr>
                    <th>Row</th>
                    <th>ExternalCaseId</th>
                    <th>Title</th>
                    <th>SLAStartDate</th>
                    <th>Priority</th>
                    <th>Employee</th>
                    <th>Result</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Rows)
                {
                    <tr>
                        <td>@row.RowNumber</td>
                        <td>@row.ExternalCaseId</td>
                        <td>@row.Title</td>
                        <td>@row.SLAStartDate</td>
                        <td>@row.Priority</td>
                        <td>@row.AssignedEmployeeNumber</td>
                        <td>
                            @if (row.IsValid)
                            {
                                <span class="text-success">Valid</span>
                            }
                            else
                            {
                                <ul class="text-danger mb-0">
                                    @foreach (var error in row.Errors)
                                    {
                                        <li>@error</li>
                                    }
                                </ul>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
