@using CaseManagementSystem.Constants

@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();

    string Active(string controllerName, string? actionName = null)
    {
        if (!string.Equals(controller, controllerName, StringComparison.OrdinalIgnoreCase))
            return "";

        if (actionName != null &&
            !string.Equals(action, actionName, StringComparison.OrdinalIgnoreCase))
            return "";

        return "active";
    }
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Case Management System</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/CaseManagementSystem.styles.css"
          asp-append-version="true" />
</head>


<body class="cms-app-body">

    @if (User.Identity?.IsAuthenticated == true)
    {
        <!-- =====================================================
         SECURITY CLASSIFICATION
         ===================================================== -->

        <div class="cms-app-classification">
            <svg width="12"
                 height="12"
                 viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2">

                <rect x="5"
                      y="11"
                      width="14"
                      height="10"
                      rx="2">
                </rect>

                <path d="M8 11V7a4 4 0 0 1 8 0v4"></path>
            </svg>

            <span>
                RESTRICTED • INTERNAL USE ONLY
            </span>
        </div>


        <div class="cms-app-shell">


            <!-- =================================================
             SIDEBAR
             ================================================= -->

            <aside class="cms-sidebar">


                <!-- Brand -->
                <a class="cms-sidebar-brand"
                   asp-controller="Home"
                   asp-action="Index">

                    <div class="cms-sidebar-logo">

                        <svg viewBox="0 0 64 64"
                             fill="none"
                             xmlns="http://www.w3.org/2000/svg">

                            <path d="M32 5L52 13V29C52 42.5 43.6 53.7 32 59C20.4 53.7 12 42.5 12 29V13L32 5Z"
                                  stroke="currentColor"
                                  stroke-width="2.5" />

                            <rect x="20"
                                  y="19"
                                  width="20"
                                  height="24"
                                  rx="3"
                                  stroke="currentColor"
                                  stroke-width="2.3" />

                            <path d="M24 25H35"
                                  stroke="currentColor"
                                  stroke-width="2.3"
                                  stroke-linecap="round" />

                            <path d="M24 31H33"
                                  stroke="currentColor"
                                  stroke-width="2.3"
                                  stroke-linecap="round" />

                            <circle cx="41"
                                    cy="40"
                                    r="6"
                                    fill="#092338"
                                    stroke="currentColor"
                                    stroke-width="2.3" />

                            <path d="M45.5 44.5L50 49"
                                  stroke="currentColor"
                                  stroke-width="2.3"
                                  stroke-linecap="round" />
                        </svg>

                    </div>

                    <div class="cms-sidebar-brand-text">
                        <span>CASE MANAGEMENT</span>
                        <strong>SYSTEM</strong>
                    </div>

                </a>


                <!-- =================================================
                 NAVIGATION
                 ================================================= -->

                <nav class="cms-sidebar-nav">


                    <!-- OPERATIONS -->
                    <div class="cms-nav-section">

                        <div class="cms-nav-title">
                            OPERATIONS
                        </div>


                        <!-- Home -->
                        <a class="cms-nav-link @Active("Home")"
                           asp-controller="Home"
                           asp-action="Index">

                            <span class="cms-nav-icon">

                                <svg width="19"
                                     height="19"
                                     viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="2">

                                    <path d="M3 11L12 3L21 11"></path>
                                    <path d="M5 10V21H19V10"></path>
                                    <path d="M9 21V14H15V21"></path>

                                </svg>

                            </span>

                            <span>
                                Home
                            </span>

                        </a>


                        <!-- Dashboard -->
                        <a class="cms-nav-link @Active("Dashboard")"
                           asp-controller="Dashboard"
                           asp-action="Index">

                            <span class="cms-nav-icon">

                                <svg width="19"
                                     height="19"
                                     viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="2">

                                    <rect x="3"
                                          y="3"
                                          width="7"
                                          height="7"
                                          rx="1">
                                    </rect>

                                    <rect x="14"
                                          y="3"
                                          width="7"
                                          height="7"
                                          rx="1">
                                    </rect>

                                    <rect x="3"
                                          y="14"
                                          width="7"
                                          height="7"
                                          rx="1">
                                    </rect>

                                    <rect x="14"
                                          y="14"
                                          width="7"
                                          height="7"
                                          rx="1">
                                    </rect>

                                </svg>

                            </span>

                            <span>
                                Dashboard
                            </span>

                        </a>


                        @if (User.IsInRole(RoleNames.Supervisor))
                        {

                            <!-- All Cases -->
                            <a class="cms-nav-link @Active("Cases", "Index")"
                               asp-controller="Cases"
                               asp-action="Index">

                                <span class="cms-nav-icon">

                                    <svg width="19"
                                         height="19"
                                         viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="2">

                                        <path d="M3 6H9L11 8H21V20H3V6Z">
                                        </path>

                                    </svg>

                                </span>

                                <span>
                                    Cases
                                </span>

                            </a>


                            <!-- Review Queue -->
                            <a class="cms-nav-link @Active("Import", "Review")"
                               asp-controller="Import"
                               asp-action="Review">

                                <span class="cms-nav-icon">

                                    <svg width="19"
                                         height="19"
                                         viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="2">

                                        <rect x="5"
                                              y="3"
                                              width="14"
                                              height="18"
                                              rx="2">
                                        </rect>

                                        <path d="M9 8H15"></path>
                                        <path d="M9 12H15"></path>
                                        <path d="M9 16H13"></path>

                                    </svg>

                                </span>

                                <span>
                                    Review Queue
                                </span>

                            </a>


                            <!-- Import Cases -->
                            <a class="cms-nav-link @Active("Import", "Index")"
                               asp-controller="Import"
                               asp-action="Index">

                                <span class="cms-nav-icon">

                                    <svg width="19"
                                         height="19"
                                         viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="2">

                                        <path d="M12 3V15"></path>
                                        <path d="M7 8L12 3L17 8"></path>
                                        <path d="M5 14V20H19V14"></path>

                                    </svg>

                                </span>

                                <span>
                                    Import Cases
                                </span>

                            </a>
                        }


                        @if (User.IsInRole(RoleNames.Expert))
                        {

                            <!-- My Cases -->
                            <a class="cms-nav-link @Active("Cases", "MyCases")"
                               asp-controller="Cases"
                               asp-action="MyCases">

                                <span class="cms-nav-icon">

                                    <svg width="19"
                                         height="19"
                                         viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="2">

                                        <path d="M3 6H9L11 8H21V20H3V6Z">
                                        </path>

                                    </svg>

                                </span>

                                <span>
                                    My Cases
                                </span>

                            </a>
                        }

                    </div>


                    @if (User.IsInRole(RoleNames.Supervisor))
                    {

                        <!-- ADMINISTRATION -->
                        <div class="cms-nav-section">

                            <div class="cms-nav-title">
                                ADMINISTRATION
                            </div>

                            <a class="cms-nav-link @Active("Users")"
                               asp-controller="Users"
                               asp-action="Index">

                                <span class="cms-nav-icon">

                                    <svg width="19"
                                         height="19"
                                         viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="2">

                                        <circle cx="9"
                                                cy="8"
                                                r="4">
                                        </circle>

                                        <path d="M2 21C2 16.6 5.1 14 9 14C12.9 14 16 16.6 16 21">
                                        </path>

                                        <path d="M17 11C19.8 11 22 13.2 22 16">
                                        </path>

                                    </svg>

                                </span>

                                <span>
                                    Team & Access
                                </span>

                            </a>

                        </div>
                    }

                </nav>


                <!-- =================================================
                 USER AREA
                 ================================================= -->

                <div class="cms-sidebar-user">


                    <div class="cms-user-summary">

                        <div class="cms-user-avatar">
                            @{
                                var userName = User.Identity?.Name ?? "U";
                                var initial = userName.Substring(0, 1).ToUpper();
                            }

                            @initial
                        </div>


                        <div class="cms-user-details">

                            <strong>
                                @User.Identity?.Name
                            </strong>

                            <span>
                                @if (User.IsInRole(RoleNames.Supervisor))
                                {
                                    <text>Supervisor</text>
                                }
                                else if (User.IsInRole(RoleNames.Expert))
                                {
                                    <text>Expert</text>
                                }
                            </span>

                        </div>

                    </div>


                    <div class="cms-secure-session">

                        <span class="cms-session-dot"></span>

                        Secure Session

                    </div>


                    <form asp-controller="Account"
                          asp-action="Logout"
                          method="post">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="cms-logout-button">

                            <svg width="16"
                                 height="16"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2">

                                <path d="M9 21H5A2 2 0 0 1 3 19V5A2 2 0 0 1 5 3H9">
                                </path>

                                <path d="M16 17L21 12L16 7">
                                </path>

                                <path d="M21 12H9">
                                </path>

                            </svg>

                            Sign Out

                        </button>

                    </form>

                </div>

            </aside>



            <!-- =================================================
             MAIN APPLICATION
             ================================================= -->

            <div class="cms-main">


                <!-- =================================================
                 TOP BAR
                 ================================================= -->

                <header class="cms-topbar">


                    <div class="cms-topbar-context">

                        <span class="cms-topbar-label">
                            CASE MANAGEMENT SYSTEM
                        </span>

                    </div>


                    <div class="cms-topbar-actions">


                        <!-- Secure Session -->
                        <div class="cms-topbar-security">

                            <svg width="15"
                                 height="15"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2">

                                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z">
                                </path>

                                <path d="M9 12L11 14L15 10">
                                </path>

                            </svg>

                            Secure Session

                        </div>


                        <div class="cms-topbar-divider">
                        </div>


                        <!-- User -->
                        <div class="cms-topbar-user">

                            <div class="cms-topbar-avatar">
                                @initial
                            </div>

                            <div class="cms-topbar-user-text">

                                <strong>
                                    @User.Identity?.Name
                                </strong>

                                <span>
                                    @if (User.IsInRole(RoleNames.Supervisor))
                                    {
                                        <text>Supervisor</text>
                                    }
                                    else if (User.IsInRole(RoleNames.Expert))
                                    {
                                        <text>Expert</text>
                                    }
                                </span>

                            </div>

                        </div>

                    </div>

                </header>



                <!-- =================================================
                 PAGE CONTENT
                 ================================================= -->

                <main class="cms-page-content"
                      role="main">

                    @RenderBody()

                </main>


                <!-- =================================================
                 FOOTER
                 ================================================= -->

                <footer class="cms-app-footer">

                    <div>
                        © 1448 Case Management System
                    </div>

                    <div class="cms-footer-security">
                        Authorized access only • Activity may be monitored
                    </div>

                </footer>

            </div>

        </div>
    }
    else
    {
        @RenderBody()
    }


    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>