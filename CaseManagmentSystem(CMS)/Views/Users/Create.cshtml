@using CaseManagementSystem.Constants
@model CaseManagementSystem.ViewModels.CreateUserViewModel

@{
    ViewData["Title"] = "Create User";

    var hasErrors =
        !ViewData.ModelState.IsValid;
}


<div class="users-form-workspace">


    <!-- =====================================================
         BACK
         ===================================================== -->

    <a asp-controller="Users"
       asp-action="Index"
       class="users-back-link">


        <svg viewBox="0 0 24 24">

            <path d="M19 12H5"></path>

            <path d="M11 18l-6-6 6-6"></path>

        </svg>


        Back to Team &amp; Access


    </a>



    <!-- =====================================================
         HEADER
         ===================================================== -->

    <div class="users-form-heading">


        <h1>
            Create User
        </h1>


        <p>
            Add a new user to the Case Management System.
        </p>


    </div>



    <section class="users-form-card">


        <!-- =================================================
             ERROR SUMMARY
             ================================================= -->
        @if (hasErrors)
        {

            <div class="users-form-alert users-form-alert-error">


                <span>


                    <svg viewBox="0 0 24 24">

                        <path d="M12 3l9 18H3z">
                        </path>

                        <path d="M12 9v5">
                        </path>

                        <path d="M12 17h.01">
                        </path>

                    </svg>


                </span>


                <div>


                    <strong>
                        Unable to create user
                    </strong>


                    <div asp-validation-summary="All"
                         class="users-validation-summary">
                    </div>


                </div>


            </div>

        }



        <form asp-controller="Users"
              asp-action="Create"
              method="post"
              class="users-form">


            @Html.AntiForgeryToken()


            <div class="users-form-grid">


                <!-- FULL NAME -->

                <div class="users-field">


                    <label asp-for="FullName">

                        Full Name
                        <span>*</span>

                    </label>


                    <input asp-for="FullName"
                           placeholder="Enter full name"
                           autocomplete="name" />


                    <span asp-validation-for="FullName"
                          class="users-field-error">
                    </span>


                </div>



                <!-- EMAIL -->

                <div class="users-field">


                    <label asp-for="Email">

                        Email
                        <span>*</span>

                    </label>


                    <input asp-for="Email"
                           placeholder="Enter email address"
                           autocomplete="email" />


                    <span asp-validation-for="Email"
                          class="users-field-error">
                    </span>


                </div>



                <!-- EMPLOYEE NUMBER -->

                <div class="users-field">


                    <label asp-for="EmployeeNumber">

                        Employee Number
                        <span>*</span>

                    </label>


                    <input asp-for="EmployeeNumber"
                           placeholder="Enter employee number"
                           autocomplete="off" />


                    <span asp-validation-for="EmployeeNumber"
                          class="users-field-error">
                    </span>


                </div>



                <!-- ROLE -->

                <div class="users-field">


                    <label asp-for="Role">

                        Role
                        <span>*</span>

                    </label>


                    <select asp-for="Role">


                        <option value="">
                            Select role
                        </option>


                        <option value="@RoleNames.Expert">
                            Expert
                        </option>


                        <option value="@RoleNames.Supervisor">
                            Supervisor
                        </option>


                    </select>


                    <span asp-validation-for="Role"
                          class="users-field-error">
                    </span>


                </div>



                <!-- USERNAME -->

                <div class="users-field">


                    <label asp-for="UserName">

                        Username
                        <span>*</span>

                    </label>


                    <input asp-for="UserName"
                           placeholder="Enter username"
                           autocomplete="off" />


                    <span asp-validation-for="UserName"
                          class="users-field-error">
                    </span>


                </div>



                <!-- PASSWORD -->

                <div class="users-field">


                    <label asp-for="Password">

                        Password
                        <span>*</span>

                    </label>


                    <div class="users-password-wrapper">


                        <input asp-for="Password"
                               id="createUserPassword"
                               type="password"
                               placeholder="Enter password"
                               autocomplete="new-password" />


                        <button type="button"
                                id="createPasswordToggle"
                                class="users-password-toggle"
                                aria-label="Show password">


                            <svg viewBox="0 0 24 24">

                                <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z">
                                </path>

                                <circle cx="12"
                                        cy="12"
                                        r="3">
                                </circle>

                            </svg>


                        </button>


                    </div>


                    <span asp-validation-for="Password"
                          class="users-field-error">
                    </span>


                </div>


            </div>



            <!-- ROLE INFO -->

            <div class="users-form-info">


                <svg viewBox="0 0 24 24">

                    <circle cx="12"
                            cy="12"
                            r="9">
                    </circle>

                    <path d="M12 11v5">
                    </path>

                    <path d="M12 8h.01">
                    </path>

                </svg>


                <span>
                    Access is determined by the selected system role.
                </span>


            </div>



            <!-- ACTIONS -->

            <div class="users-form-actions">


                <a asp-controller="Users"
                   asp-action="Index"
                   class="users-cancel-button">

                    Cancel

                </a>


                <button type="submit"
                        class="users-submit-button">


                    <svg viewBox="0 0 24 24">

                        <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2">
                        </path>

                        <circle cx="8.5"
                                cy="7"
                                r="4">
                        </circle>

                        <path d="M19 8v6">
                        </path>

                        <path d="M16 11h6">
                        </path>

                    </svg>


                    Create User


                </button>


            </div>


        </form>


    </section>


</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />


    <script>
        (() => {

            const button =
                document.getElementById(
                    "createPasswordToggle"
                );

            const input =
                document.getElementById(
                    "createUserPassword"
                );


            button?.addEventListener(
                "click",
                () => {

                    const showing =
                        input.type === "text";


                    input.type =
                        showing
                            ? "password"
                            : "text";


                    button.setAttribute(
                        "aria-label",
                        showing
                            ? "Show password"
                            : "Hide password"
                    );

                }
            );

        })();
    </script>

}