@using CaseManagementSystem.Constants
@model CaseManagementSystem.ViewModels.EditUserViewModel

@{
    ViewData["Title"] = "Edit User";

    var hasErrors =
        !ViewData.ModelState.IsValid;
}


<div class="users-form-workspace">


    <!-- BACK -->

    <a asp-controller="Users"
       asp-action="Index"
       class="users-back-link">


        <svg viewBox="0 0 24 24">

            <path d="M19 12H5"></path>

            <path d="M11 18l-6-6 6-6"></path>

        </svg>


        Back to Team &amp; Access


    </a>



    <!-- HEADER -->

    <div class="users-form-heading">


        <h1>
            Edit User
        </h1>


        <p>
            Update user information and assigned role.
        </p>


    </div>



    <section class="users-form-card">


        @if (hasErrors)
        {

            <div class="users-form-alert users-form-alert-error">


                <span>


                    <svg viewBox="0 0 24 24">

                        <path d="M12 3l9 18H3z">
                        </path>

                        <path d="M12 9v5">
                        </path>

                        <path d="M12 17h.01">
                        </path>

                    </svg>


                </span>


                <div>


                    <strong>
                        Unable to update user
                    </strong>


                    <div asp-validation-summary="All"
                         class="users-validation-summary">
                    </div>


                </div>


            </div>

        }



        <form asp-controller="Users"
              asp-action="Edit"
              method="post"
              class="users-form">


            @Html.AntiForgeryToken()


            <input asp-for="Id"
                   type="hidden" />



            <div class="users-form-grid">


                <!-- FULL NAME -->

                <div class="users-field">


                    <label asp-for="FullName">

                        Full Name
                        <span>*</span>

                    </label>


                    <input asp-for="FullName"
                           placeholder="Enter full name" />


                    <span asp-validation-for="FullName"
                          class="users-field-error">
                    </span>


                </div>



                <!-- EMAIL -->

                <div class="users-field">


                    <label asp-for="Email">

                        Email
                        <span>*</span>

                    </label>


                    <input asp-for="Email"
                           placeholder="Enter email address" />


                    <span asp-validation-for="Email"
                          class="users-field-error">
                    </span>


                </div>



                <!-- EMPLOYEE NUMBER -->

                <div class="users-field">


                    <label asp-for="EmployeeNumber">

                        Employee Number
                        <span>*</span>

                    </label>


                    <input asp-for="EmployeeNumber"
                           placeholder="Enter employee number" />


                    <span asp-validation-for="EmployeeNumber"
                          class="users-field-error">
                    </span>


                    <small>
                        Employee Number must remain unique across all users.
                    </small>


                </div>



                <!-- ROLE -->

                <div class="users-field">


                    <label asp-for="Role">

                        Role
                        <span>*</span>

                    </label>


                    <select asp-for="Role">


                        <option value="@RoleNames.Expert">
                            Expert
                        </option>


                        <option value="@RoleNames.Supervisor">
                            Supervisor
                        </option>


                    </select>


                    <span asp-validation-for="Role"
                          class="users-field-error">
                    </span>


                </div>



                <!-- USERNAME -->

                <div class="users-field">


                    <label asp-for="UserName">

                        Username
                        <span>*</span>

                    </label>


                    <input asp-for="UserName"
                           placeholder="Enter username" />


                    <span asp-validation-for="UserName"
                          class="users-field-error">
                    </span>


                </div>


            </div>



            <div class="users-form-info">


                <svg viewBox="0 0 24 24">

                    <circle cx="12"
                            cy="12"
                            r="9">
                    </circle>

                    <path d="M12 11v5">
                    </path>

                    <path d="M12 8h.01">
                    </path>

                </svg>


                <span>
                    Changing the role changes the user's system permissions.
                </span>


            </div>



            <!-- ACTIONS -->

            <div class="users-form-actions">


                <a asp-controller="Users"
                   asp-action="Index"
                   class="users-cancel-button">

                    Cancel

                </a>


                <button type="submit"
                        class="users-submit-button">


                    <svg viewBox="0 0 24 24">

                        <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z">
                        </path>

                        <path d="M17 21v-8H7v8">
                        </path>

                        <path d="M7 3v5h8">
                        </path>

                    </svg>


                    Save Changes


                </button>


            </div>


        </form>


    </section>


</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}