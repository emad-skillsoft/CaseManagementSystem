@using CaseManagementSystem.Constants
@model IEnumerable<CaseManagementSystem.ViewModels.UserListItemViewModel>

@{
    ViewData["Title"] = "Team & Access";

    var users =
        Model.ToList();

    var totalUsers =
        users.Count;

    var experts =
        users.Count(
            x =>
                x.Role ==
                RoleNames.Expert
        );

    var supervisors =
        users.Count(
            x =>
                x.Role ==
                RoleNames.Supervisor
        );


    string Initials(string fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName))
        {
            return "U";
        }

        var parts =
            fullName.Split(
                ' ',
                StringSplitOptions.RemoveEmptyEntries
            );

        if (parts.Length == 1)
        {
            return parts[0]
                .Substring(0, 1)
                .ToUpperInvariant();
        }

        return (
            parts[0].Substring(0, 1) +
            parts[1].Substring(0, 1)
        ).ToUpperInvariant();
    }


    string RoleClass(string role)
    {
        return role switch
        {
            RoleNames.Expert =>
                "users-role-expert",

            RoleNames.Supervisor =>
                "users-role-supervisor",

            _ =>
                "users-role-default"
        };
    }
}


<div class="users-workspace">


    <!-- =====================================================
         HEADER
         ===================================================== -->

    <div class="users-page-header">


        <div>


            <h1>
                Team &amp; Access
            </h1>


            <p>
                Manage system users and assigned roles.
            </p>


        </div>


        <a asp-controller="Users"
           asp-action="Create"
           class="users-create-button">


            <svg viewBox="0 0 24 24">

                <path d="M12 5v14"></path>

                <path d="M5 12h14"></path>

            </svg>


            Create User


        </a>


    </div>



    <!-- =====================================================
         SUCCESS MESSAGE
         ===================================================== -->
    @if (TempData["UserSuccess"] != null)
    {

        <div class="users-alert users-alert-success">


            <span class="users-alert-icon">


                <svg viewBox="0 0 24 24">

                    <circle cx="12"
                            cy="12"
                            r="9">
                    </circle>

                    <path d="M8 12l3 3 5-6">
                    </path>

                </svg>


            </span>


            <div>


                <strong>
                    @TempData["UserSuccess"]
                </strong>


                <span>
                    The user information has been saved successfully.
                </span>


            </div>


        </div>

    }



    <!-- =====================================================
         KPI CARDS
         ===================================================== -->

    <section class="users-kpi-grid">


        <!-- TOTAL USERS -->

        <article class="users-kpi-card">


            <span class="users-kpi-icon users-kpi-blue">


                <svg viewBox="0 0 24 24">

                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2">
                    </path>

                    <circle cx="9"
                            cy="7"
                            r="4">
                    </circle>

                    <path d="M22 21v-2a4 4 0 0 0-3-3.87">
                    </path>

                    <path d="M16 3.13a4 4 0 0 1 0 7.75">
                    </path>

                </svg>


            </span>


            <div>


                <span>
                    Total Users
                </span>


                <strong>
                    @totalUsers
                </strong>


                <small>
                    All system users
                </small>


            </div>


        </article>



        <!-- EXPERTS -->

        <article class="users-kpi-card">


            <span class="users-kpi-icon users-kpi-green">


                <svg viewBox="0 0 24 24">

                    <circle cx="12"
                            cy="8"
                            r="4">
                    </circle>

                    <path d="M4 21a8 8 0 0 1 16 0">
                    </path>

                </svg>


            </span>


            <div>


                <span>
                    Experts
                </span>


                <strong>
                    @experts
                </strong>


                <small>
                    Case experts
                </small>


            </div>


        </article>



        <!-- SUPERVISORS -->

        <article class="users-kpi-card">


            <span class="users-kpi-icon users-kpi-purple">


                <svg viewBox="0 0 24 24">

                    <path d="M12 3l8 4v5c0 5-3.4 8.4-8 9-4.6-.6-8-4-8-9V7z">
                    </path>

                    <circle cx="12"
                            cy="10"
                            r="2">
                    </circle>

                    <path d="M8.5 16a4 4 0 0 1 7 0">
                    </path>

                </svg>


            </span>


            <div>


                <span>
                    Supervisors
                </span>


                <strong>
                    @supervisors
                </strong>


                <small>
                    System supervisors
                </small>


            </div>


        </article>


    </section>



    <!-- =====================================================
         USERS PANEL
         ===================================================== -->

    <section class="users-list-card">


        <!-- TOOLBAR -->

        <div class="users-list-toolbar">


            <div>


                <h2>
                    Users
                </h2>


                <span id="usersVisibleCount">
                    @totalUsers users
                </span>


            </div>



            <div class="users-filter-row">


                <!-- SEARCH -->

                <div class="users-search-box">


                    <svg viewBox="0 0 24 24">

                        <circle cx="11"
                                cy="11"
                                r="7">
                        </circle>

                        <path d="M20 20l-4-4">
                        </path>

                    </svg>


                    <input type="search"
                           id="usersSearch"
                           placeholder="Search by name, employee #, username or email..."
                           autocomplete="off" />


                </div>



                <!-- ROLE FILTER -->

                <select id="usersRoleFilter"
                        class="users-role-filter">

                    <option value="">
                        All Roles
                    </option>

                    <option value="@RoleNames.Expert">
                        Expert
                    </option>

                    <option value="@RoleNames.Supervisor">
                        Supervisor
                    </option>

                </select>


            </div>


        </div>



        <!-- TABLE -->

        <div class="table-responsive">


            <table class="users-table">


                <thead>


                    <tr>

                        <th>
                            Full Name
                        </th>

                        <th>
                            Employee Number
                        </th>

                        <th>
                            Username
                        </th>

                        <th>
                            Email
                        </th>

                        <th>
                            Role
                        </th>

                        <th>
                            Action
                        </th>

                    </tr>


                </thead>



                <tbody id="usersTableBody">


                    @foreach (var user in users)
                    {

                        <tr class="users-data-row"
                            data-role="@user.Role">


                            <!-- NAME -->

                            <td>


                                <div class="users-person">


                                    <span class="users-avatar @RoleClass(user.Role)">

                                        @Initials(user.FullName)

                                    </span>


                                    <strong>
                                        @user.FullName
                                    </strong>


                                </div>


                            </td>



                            <!-- EMPLOYEE -->

                            <td>

                                <span class="users-employee-number">

                                    @user.EmployeeNumber

                                </span>

                            </td>



                            <!-- USERNAME -->

                            <td>

                                <span class="users-secondary-value">

                                    @user.UserName

                                </span>

                            </td>



                            <!-- EMAIL -->

                            <td>

                                <span class="users-email">

                                    @user.Email

                                </span>

                            </td>



                            <!-- ROLE -->

                            <td>


                                <span class="users-role-badge @RoleClass(user.Role)">

                                    @user.Role

                                </span>


                            </td>



                            <!-- ACTION -->

                            <td>


                                <a asp-controller="Users"
                                   asp-action="Edit"
                                   asp-route-id="@user.Id"
                                   class="users-edit-button">


                                    <svg viewBox="0 0 24 24">

                                        <path d="M12 20h9">
                                        </path>

                                        <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4z">
                                        </path>

                                    </svg>


                                    Edit


                                </a>


                            </td>


                        </tr>

                    }



                    <!-- FILTER EMPTY STATE -->

                    <tr id="usersFilteredEmpty"
                        class="users-filter-empty"
                        hidden>


                        <td colspan="6">


                            <div>


                                <svg viewBox="0 0 24 24">

                                    <circle cx="11"
                                            cy="11"
                                            r="7">
                                    </circle>

                                    <path d="M20 20l-4-4">
                                    </path>

                                </svg>


                                <strong>
                                    No matching users
                                </strong>


                                <span>
                                    Try changing the search text or role filter.
                                </span>


                            </div>


                        </td>


                    </tr>


                    @if (!users.Any())
                    {

                        <tr class="users-empty-row">


                            <td colspan="6">


                                <div>


                                    <svg viewBox="0 0 24 24">

                                        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2">
                                        </path>

                                        <circle cx="9"
                                                cy="7"
                                                r="4">
                                        </circle>

                                    </svg>


                                    <strong>
                                        No users available
                                    </strong>


                                    <span>
                                        Create the first user to begin.
                                    </span>


                                </div>


                            </td>


                        </tr>

                    }


                </tbody>


            </table>


        </div>



        <!-- FOOTER -->

        <div class="users-list-footer">


            <span>

                Showing
                <strong id="usersFooterCount">
                    @totalUsers
                </strong>
                of @totalUsers users

            </span>


        </div>


    </section>



    <!-- =====================================================
         ROLE INFORMATION
         ===================================================== -->

    <section class="users-role-info">


        <span class="users-role-info-icon">


            <svg viewBox="0 0 24 24">

                <circle cx="12"
                        cy="12"
                        r="9">
                </circle>

                <path d="M12 11v5">
                </path>

                <path d="M12 8h.01">
                </path>

            </svg>


        </span>


        <div>


            <strong>
                About Roles
            </strong>


            <div class="users-role-description">


                <span>

                    <b>Expert:</b>
                    Works on cases assigned to their account.

                </span>


                <span>

                    <b>Supervisor:</b>
                    Manages users and performs supervisory case functions.

                </span>


            </div>


        </div>


    </section>


</div>


@section Scripts {

    <script>
        (() => {

            const search =
                document.getElementById("usersSearch");

            const roleFilter =
                document.getElementById("usersRoleFilter");

            const rows =
                Array.from(
                    document.querySelectorAll(".users-data-row")
                );

            const emptyRow =
                document.getElementById("usersFilteredEmpty");

            const visibleCount =
                document.getElementById("usersVisibleCount");

            const footerCount =
                document.getElementById("usersFooterCount");


            function applyUserFilters() {

                const searchValue =
                    search.value
                        .trim()
                        .toLowerCase();

                const selectedRole =
                    roleFilter.value;


                let visible = 0;


                rows.forEach(row => {

                    const rowText =
                        row.innerText
                            .toLowerCase();

                    const rowRole =
                        row.dataset.role || "";


                    const matchesSearch =
                        !searchValue ||
                        rowText.includes(searchValue);


                    const matchesRole =
                        !selectedRole ||
                        rowRole === selectedRole;


                    const show =
                        matchesSearch &&
                        matchesRole;


                    row.hidden =
                        !show;


                    if (show) {
                        visible++;
                    }

                });


                if (emptyRow) {
                    emptyRow.hidden =
                        visible !== 0 ||
                        rows.length === 0;
                }


                if (visibleCount) {

                    visibleCount.textContent =
                        `${visible} user${visible === 1 ? "" : "s"}`;

                }


                if (footerCount) {

                    footerCount.textContent =
                        visible;

                }

            }


            search?.addEventListener(
                "input",
                applyUserFilters
            );


            roleFilter?.addEventListener(
                "change",
                applyUserFilters
            );

        })();
    </script>

}