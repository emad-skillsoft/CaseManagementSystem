@model IEnumerable<CaseManagementSystem.Models.ApplicationUser>

@{
    ViewData["Title"] = "Users";
}

<h2>Users</h2>

<a asp-action="Create" class="btn btn-primary mb-3">
    Create User
</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Full Name</th>
            <th>Employee #</th>
            <th>Username</th>
            <th>Email</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.FullName</td>
                <td>@user.EmployeeNumber</td>
                <td>@user.UserName</td>
                <td>@user.Email</td>
                <td>
                    <a asp-action="Edit"
                       asp-route-id="@user.Id"
                       class="btn btn-sm btn-outline-primary">
                        Edit
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>